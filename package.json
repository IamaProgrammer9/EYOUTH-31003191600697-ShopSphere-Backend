{
  "name": "ts-express-esm",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "build": "prisma generate --schema=prisma/schema.prisma && tsc",
    "prod:deploy": "prisma migrate deploy --schema=prisma/schema.prisma && npm run db:seed && npm start",
    "start": "node dist/server.js",
    "dev": "tsx --watch src/server.js",
    "db:push": "npx prisma db push",
    "db:mongo:push": "npx prisma db push --schema=prisma-mongodb/schema.prisma",
    "db:generate": "npx prisma generate --schema=prisma/schema.prisma && npx prisma generate --schema=prisma-mongodb/schema.prisma",
    "db:test:push": "dotenv -e .env.test -- npx prisma db push --accept-data-loss",
    "pretest": "npm run db:test:push && dotenv -e .env.test -- npx prisma db seed",
    "test": "DOTENV_CONFIG_PATH=.env.test NODE_OPTIONS=\"--experimental-vm-modules -r dotenv/config\" npx jest --runInBand --detectOpenHandles",
    "generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "migrate": "npx prisma migrate dev --schema=./prisma/schema.prisma && npx prisma migrate deploy --schema=./prisma/schema.prisma",
    "postgres-studio": "npx prisma studio --schema=./prisma/schema.prisma",
    "mongodb-studio": "npx prisma studio --schema=./prisma-mongodb/schema.prisma",
    "db:seed": "npx prisma db seed --schema=prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@vercel/node": "^8.1.2",
    "dotenv-cli": "^11.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/client": "6.19",
    "@types/axios": "^0.9.36",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jest": "^30.4.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "prisma": "6.19",
    "tsx": "^4.23.0"
  },
  "description": "The backend for the NileBridge platform, it uses a modern stack with express as the backbone and prisma with flexible databases according to the requirements. ## Commands 1. Generate prisma client (mongdb): `npx prisma generate --schema=./prisma-mongodb/schema.prisma` 2. Generate prisma client (postgres): `npx prisma generate --schema=./prisma/schema.prisma`",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IamaProgrammer9/nile-bridge-backend-term2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IamaProgrammer9/nile-bridge-backend-term2/issues"
  },
  "homepage": "https://github.com/IamaProgrammer9/nile-bridge-backend-term2#readme"
}
